PORT=8080
NODE_ENV=development
GOOGLE_CLOUD_REGION=europe-west1

GEMINI_API_KEY=replace-with-gemini-key
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
GEMINI_ALLOWED_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

IGDB_TWITCH_CLIENT_ID=replace-with-twitch-client-id
IGDB_TWITCH_CLIENT_SECRET=replace-with-twitch-client-secret

CUSTOM_SEARCH_API_KEY=replace-with-google-custom-search-key
CUSTOM_SEARCH_CX=replace-with-programmable-search-engine-id

# Optional metadata cache. If these are omitted, the proxy still works without Cloud SQL.
CLOUD_SQL_CONNECTION_NAME=
POSTGRES_DB=fuzioncache
POSTGRES_USER=fuzion_app
POSTGRES_PASSWORD=

CUSTOM_SEARCH_CACHE_TTL_SECONDS=604800
IGDB_CACHE_TTL_SECONDS=604800

# Icon binary cache. Without ASSET_BUCKET the backend returns upstream icon URLs unchanged.
ASSET_BUCKET=
ICON_FETCH_TIMEOUT_MS=10000
ICON_CACHE_CONCURRENCY=4

# Absolute base URL used to build /asset/... links. Leave blank to derive it from the
# incoming request (X-Forwarded-Proto + Host).
PUBLIC_BASE_URL=

# Rate limiting for the quota-spending proxies (/gemini, /custom-search, /igdb) only.
# 0 disables it. /get/* and /insert/* are never throttled: a large library issues one
# lookup per title and the desktop client does not retry.
# Before enabling, confirm how many entries the infrastructure appends to X-Forwarded-For
# and set TRUSTED_PROXY_HOPS to match, or the limit is either bypassable or shared by
# every user behind the proxy.
RATE_LIMIT_MAX_REQUESTS=0
RATE_LIMIT_WINDOW_MS=60000
TRUSTED_PROXY_HOPS=1
