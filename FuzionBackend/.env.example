PORT=8080
NODE_ENV=development
GOOGLE_CLOUD_REGION=europe-west1

GEMINI_API_KEY=replace-with-gemini-key
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
GEMINI_ALLOWED_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

IGDB_TWITCH_CLIENT_ID=replace-with-twitch-client-id
IGDB_TWITCH_CLIENT_SECRET=replace-with-twitch-client-secret

CUSTOM_SEARCH_API_KEY=replace-with-google-custom-search-key
CUSTOM_SEARCH_CX=replace-with-programmable-search-engine-id

# Optional metadata cache. If these are omitted, the proxy still works without Cloud SQL.
CLOUD_SQL_CONNECTION_NAME=
POSTGRES_DB=fuzion
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

CUSTOM_SEARCH_CACHE_TTL_SECONDS=604800
IGDB_CACHE_TTL_SECONDS=604800