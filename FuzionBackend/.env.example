PORT=8080
NODE_ENV=development
GOOGLE_CLOUD_REGION=europe-west1

GEMINI_API_KEY=replace-with-gemini-key
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
GEMINI_ALLOWED_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

IGDB_TWITCH_CLIENT_ID=replace-with-twitch-client-id
IGDB_TWITCH_CLIENT_SECRET=replace-with-twitch-client-secret

CUSTOM_SEARCH_API_KEY=replace-with-google-custom-search-key
CUSTOM_SEARCH_CX=replace-with-programmable-search-engine-id

# Optional metadata cache. If these are omitted, the proxy still works without Cloud SQL.
# Set CLOUD_SQL_CONNECTION_NAME in Cloud Run; use POSTGRES_HOST/PORT to run against a
# plain Postgres locally. CLOUD_SQL_CONNECTION_NAME wins if both are set.
CLOUD_SQL_CONNECTION_NAME=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=fuzioncache
POSTGRES_USER=fuzion_app
POSTGRES_PASSWORD=

CUSTOM_SEARCH_CACHE_TTL_SECONDS=604800
IGDB_CACHE_TTL_SECONDS=604800

# Icon binary cache. Without ASSET_BUCKET the backend returns upstream icon URLs unchanged.
ASSET_BUCKET=
ICON_FETCH_TIMEOUT_MS=10000
ICON_CACHE_CONCURRENCY=4

# Absolute base URL used to build /asset/... links. Leave blank to derive it from the
# incoming request (X-Forwarded-Proto + Host).
PUBLIC_BASE_URL=

# Rate limiting for the quota-spending proxies (/gemini, /custom-search, /igdb) only.
# 0 disables it. /get/* and /insert/* are never throttled: a large library issues one
# lookup per title and the desktop client does not retry.
# Before enabling, confirm how many entries the infrastructure appends to X-Forwarded-For
# and set TRUSTED_PROXY_HOPS to match, or the limit is either bypassable or shared by
# every user behind the proxy.
RATE_LIMIT_MAX_REQUESTS=0
RATE_LIMIT_WINDOW_MS=60000
TRUSTED_PROXY_HOPS=1

# /insert/* is unauthenticated, so an icon on a row that already has one is treated as a
# proposal rather than an edit. It is applied once this many distinct submitters send the
# same URL; the contributor who established the current icon can always replace it.
ICON_CONFIRMATIONS_REQUIRED=3
ICON_PROPOSAL_RETENTION_DAYS=30

# Keys the hash that identifies a submitter for the confirmation count above. Set it to a
# long random value in Secret Manager: without it the fingerprints are an unsalted hash of
# the client address, which is a small enough space to reverse by brute force.
SUBMITTER_SALT=

# Is-game verdict cache (/classify/programs). Verdicts from IGDB and Gemini share one table,
# so a second run for the same library reaches neither service. Negatives are cached too.
CLASSIFICATION_CACHE_TTL_SECONDS=2592000
CLASSIFICATION_BATCH_SIZE=75
CLASSIFICATION_MAX_ITEMS=500

# Wall-clock slice a single classify request may spend on IGDB, which is queried one title
# at a time and rate-limits hard. Whatever IGDB does not reach in time falls through to
# Gemini, which takes them 75 at a time. 0 skips the IGDB stage entirely.
IGDB_RESOLVE_BUDGET_MS=15000
