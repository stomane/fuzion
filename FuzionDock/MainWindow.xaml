    <Grid x:Name="MainParent" Background="Transparent" Focusable="False">
        <!--Rows for top and bottom position-->
        <Grid.RowDefinitions>
            <RowDefinition Name="DockLocationBottomRow" Height="Auto"/>
            <RowDefinition Name="DockRow" Height="Auto"/>
            <RowDefinition Name="DockLocationTopRow" Height="Auto"/>
        </Grid.RowDefinitions>
        <!--Columns for left and right position-->
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Name="DockLocationLeft" Width="0"/>
            <ColumnDefinition Name="DockRowLeftRight" Width="0"/>
            <ColumnDefinition Name="DockLocationRight" Width="0"/>
        </Grid.ColumnDefinitions>-->
        <ScrollViewer
            PanningMode="HorizontalOnly"
            Grid.Row="1"
            AllowDrop="True"
            PreviewKeyDown="GridScrollViewer_PreviewKeyDown"
            DragEnter="GridScrollViewer_DragEnter"
            Loaded="GridScrollViewer_Loaded"
            HorizontalContentAlignment="Center"
            Background="{Binding Converter={StaticResource ScrollViewerBackgroundColorConverter}}"
            x:Name="GridScrollViewer" 
            HorizontalScrollBarVisibility="Hidden" 
            VerticalScrollBarVisibility="Hidden" 
            PreviewMouseWheel="GridScrollViewer_PreviewMouseWheel"
            ScrollChanged="GridScrollViewer_ScrollChanged"
            Focusable="False" 
            FocusVisualStyle="{x:Null}"
            >
            <!--local:AdvancedZooming.KeepInCenter="True"-->
            
            <!--The content we are scrolling is the grid with the offsets and the dock in the  middle col-->
            <Grid x:Name="GridScrollOffsetParent">
                <!--Columns for top and bottom position-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Name="OffsetBefore"
                                      Width="{Binding ActualWidth,  ElementName=MainParent, Converter={StaticResource PercentageOfElementConverter}, ConverterParameter={StaticResource 10%}}"/>
                    <ColumnDefinition Name="MiddleGrid" Width="*"/>
                    <ColumnDefinition Name="OffsetAfter" 
                                      Width="{Binding ActualWidth,  ElementName=MainParent, Converter={StaticResource PercentageOfElementConverter}, ConverterParameter={StaticResource 10%}}"/>
                </Grid.ColumnDefinitions>
             
                <!--Rows for left and right position-->
                <!--<Grid.RowDefinitions>
                    <RowDefinition Name="OffsetBeforeLR"
                                      Height="{Binding ActualHeight,  ElementName=MainParent, Converter={StaticResource PercentageOfElementConverter}, ConverterParameter={StaticResource 10%}}"/>
                    <RowDefinition Name="MiddleGridLR" Height="*"/>
                    <RowDefinition Name="OffsetAfterLR" 
                                      Height="{Binding ActualHeight,  ElementName=MainParent, Converter={StaticResource PercentageOfElementConverter}, ConverterParameter={StaticResource 10%}}"/>
                </Grid.RowDefinitions>-->
                <!--The offset Mediator-->
                <!--<local:ScrollViewerOffsetMediator
                    x:Name="Mediator" 
                    Loaded="Mediator_Loaded" 
                    ScrollViewer="{Binding ElementName=GridScrollViewer}"
                    ScrollableWidthMultiplier="0" 
                    ScrollableHeightMultiplier="0"
                    TimeDuration="00:00:00.20"/>-->
                <!--The actual game dock grid-->
                <Grid x:Name="mainGrid" 
                      Grid.Column="1" 
                      Grid.Row="1" 
                      Background="#01000000" 
                      Width="Auto" 
                      Height="Auto" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Top" 
                      ScrollViewer.CanContentScroll="False">
                </Grid>
            </Grid>
            
            <ScrollViewer.OpacityMask>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" >
                    <GradientStop/>
                    <GradientStop Color="White" Offset="0.1"/>
                    <GradientStop Color="White" Offset="0.9"/>
                    <GradientStop Offset="1"/>
                </LinearGradientBrush>
            </ScrollViewer.OpacityMask>
        </ScrollViewer>
        <Grid x:Name="AuxGrid">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" x:Name="LoadingRectangle" Visibility="Hidden" Fill="#FF30C54B" RadiusY="5" RadiusX="5" Width="10" Height="10" RenderTransformOrigin="0.5,0.5" Stroke="Transparent">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Grid x:Name="ChatGrid" Width="128" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Image x:Name="discordLaunchButton"
                       Opacity="0.75"
                       Visibility="Hidden"
                       MouseLeftButtonDown="DiscordChat_MouseDown"
                       Style="{StaticResource GameButtonStyleStatic}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="Assets/64x/discord64xCircle.png"
                       Grid.Column="0" 
                       Width="25"
                       Height="25"
                       RenderOptions.BitmapScalingMode="HighQuality"></Image>
                <Image x:Name="steamFriendsLaunchButton"
                       Opacity="0.75"
                       Visibility="Hidden"
                       MouseLeftButtonDown="SteamFriendsChat_MouseDown" 
                       Style="{DynamicResource GameButtonStyleStatic}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="Assets/64x/steam64x.png"
                       Grid.Column="1"
                       Width="25" 
                       Height="25"
                       RenderOptions.BitmapScalingMode="HighQuality"></Image>
                <!--<Grid Name="GameLabelsGrid">
                    <Border Width="128"
                        Grid.Row="1"
                        Height="20"
                        CornerRadius="10"
                        Background="#33FFFFFF">
                        <Label Content="Minecraft"
                           Foreground="White"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           FontFamily="Lato Light"
                           FontSize="10"/>
                    </Border>
                </Grid>-->
            </Grid>

            <Grid x:Name="SearchBarParent" Grid.Row="1" Width="Auto" Height="Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="0" Height="0" x:Name="FocusPixel" Focusable="True" FocusVisualStyle="{x:Null}"/>

                <!--width and height is 0 because unused-->
                <Grid Visibility="Hidden" x:Name="DealGrid" Width="0" Height="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                  
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="3.4*" />
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="0.8*"/>
                        <!--<ColumnDefinition Width="0"/>
                        <ColumnDefinition Width="0"/>-->
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="0.3*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border x:Name="DealBackgroundBorder" Grid.ColumnSpan="6" Background="White" CornerRadius="10"/>

                    <Image RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality" Width="20" Opacity="0.6" Name="ShuffleDealsButton" Source="Assets/64x/shuffleBlack.png" MouseEnter="HideDealButton_MouseEnter" MouseLeave="HideDealButton_MouseLeave" MouseLeftButtonDown="ShuffleDealsButton_MouseLeftButtonDown">
                        <Image.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Image.RenderTransform>
                    </Image>

                    <Label x:Name="DealName" Grid.Column="1" Content="Awesome Game Deal" HorizontalAlignment="Left" FontFamily="Roboto Light"/>
                    <Label Visibility="Visible" x:Name="DealSource" Grid.Column="2" Content="Steam" HorizontalAlignment="Left" FontFamily="Roboto Light"/>
                    <Label Visibility="Visible" x:Name="DealDiscountPercent" Grid.Column="3" Content="80%" HorizontalAlignment="Center" FontFamily="Roboto Light"/>
                    <Label x:Name="DealPrice" Grid.Column="4" Content="129.99$" HorizontalAlignment="Center" FontFamily="Roboto Light"/>
                    <Label x:Name="DealLink" Content="" HorizontalAlignment="Center" Width="0" Height="0"/>

                    <Image Name="HideDealButton" MouseLeftButtonDown="HideDealButton_MouseLeftButtonDown" Grid.Column="5" HorizontalAlignment="Center" Source="Assets/64x/closeButtonDark.png" Width="10" MouseEnter="HideDealButton_MouseEnter" MouseLeave="HideDealButton_MouseLeave" Opacity="0.6" ToolTip="Hide" RenderOptions.BitmapScalingMode="HighQuality"/>
                    
                    <Border Name="DealHitTestBorder" ToolTip="{Binding ElementName=DealName, Path=Content}" Grid.Column="1" Grid.ColumnSpan="4" Background="#02FFFFFF" CornerRadius="10" MouseEnter="DealBorder_MouseEnter" MouseLeave="DealBorder_MouseLeave" MouseLeftButtonDown="DealHitTestBorder_MouseLeftButtonDown"/>
                </Grid>
                <!--Margin="190,0,190,0"-->
                <TextBox 
                    Visibility="Hidden" 
                    TextChanged="SearchTextBox_TextChanged" 
                    GotKeyboardFocus="SearchTextBox_GotKeyboardFocus" 
                    LostKeyboardFocus="SearchTextBox_LostKeyboardFocus" 
                    GotFocus="SearchTextBox_GotFocus" 
                    LostFocus="SearchTextBox_LostFocus"
                    Grid.Row="1" 
                    BorderThickness="0" 
                    Background="#66FFFFFF" 
                    x:Name="SearchTextBox" 
                    VerticalAlignment="Center" 
                    Height="20" 
                    HorizontalContentAlignment="Center" 
                    VerticalContentAlignment="Center" 
                    Style="{DynamicResource AnimatedSearchTextBox}" 
                    FontFamily="Roboto" 
                    Foreground="#FF646464"
                    PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>
                <Image Visibility="Hidden" x:Name="SearchIconImage" VerticalAlignment="Center" Source="Assets/64x/searchicon.png" Width="16" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>

            <Grid Grid.Row="2" x:Name="SearchResultsGrid" Width="Auto" Height="Auto"/>
        </Grid>
        <!-- Drag Border -->
        <Border Name="DragBorder"
                Visibility="Collapsed"
                        Grid.Column="1"
                        Grid.Row="1"
                Background="#19FFFFFF"
                Width="{Binding ElementName=GridScrollViewer, Path=Width}"
                Height="{Binding ElementName=GridScrollViewer, Path=Height}"
                AllowDrop="True"
                DragOver="DragBorder_DragOver"
                Drop="DragBorder_Drop"
                DragLeave="DragBorder_DragLeave"
                PreviewGiveFeedback="DragBorder_PreviewGiveFeedback"
                />

    </Grid>

</Window>
