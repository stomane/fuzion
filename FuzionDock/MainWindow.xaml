<Window x:Class="Fuzion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fuzion"
        xmlns:properties="clr-namespace:Fuzion.Properties"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Fuzion Dock" 
        Loaded="MainWindow_Loaded" 
        x:Name="mainWindow" 
        Height="Auto" 
        Width="Auto"
        WindowStyle="None" 
        ResizeMode="NoResize" 
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" 
        HorizontalContentAlignment="Center" 
        VerticalContentAlignment="Center" 
        WindowStartupLocation="Manual" 
        LostFocus="MainWindow_LostFocus" 
        GotFocus="MainWindow_GotFocus" 
        Activated="MainWindow_Activated" 
        Deactivated="MainWindow_Deactivated" 
        StateChanged="MainWindow_StateChanged" 
        Closed="mainWindow_Closed" 
        DpiChanged="mainWindow_DpiChanged"
        Mouse.MouseMove="MainWindow_MouseMove"
        Mouse.MouseUp="mainWindow_MouseUp"
        MouseLeave="mainWindow_MouseLeave"
        PreviewKeyDown="mainWindow_PreviewKeyDown"
        IsKeyboardFocusWithinChanged="mainWindow_IsKeyboardFocusWithinChanged">
    <Window.Resources>
        <local:ContextMenuEditHeader x:Key="ContextMenuEditHeaderConverter"/>
        <Storyboard x:Key="ScrollAnimation" Storyboard.Target="{Binding ElementName=Mediator}" Storyboard.TargetProperty="{Binding ElementName=Mediator, Path=ScrollableWidthMultiplierProperty}">
            <DoubleAnimation From="{Binding ElementName=Mediator, Path=ScrollableWidthMultiplier}" To="0.5">
            </DoubleAnimation>
        </Storyboard>
        <ContextMenu Style="{StaticResource FuzionContextMenu}" x:Key="GlobalContextMenu" Background="#FF2E2E2E">
            <MenuItem Header="_Add" Click="AddGameButton_Click" FontFamily="Lato Light" Foreground="White" Template="{DynamicResource FuzionMenuItem}" FontSize="14">
                <MenuItem.Icon>
                    <Image Source="Assets/32x/add.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Remove" Click="RemoveGameButton_Click" FontFamily="Lato Light" Foreground="White" Template="{DynamicResource FuzionMenuItem}" FontSize="14">
                <MenuItem.Icon>
                    <Image Source="Assets/32x/remove.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem DataContext="{Binding mainWindow}"
                      Header="_Edit"
                      Click="EditGameButton_Click"
                      FontFamily="Lato Light"
                      Foreground="White"
                      Template="{DynamicResource FuzionMenuItem}" FontSize="14">
                <!--<MenuItem.Header>
                    <TextBlock>
                        <Span>
                            <Run Text="_Edit" />
                        </Span>
                        <Span FontWeight="Bold" FontStyle="Italic">
                            <Run Text="Bold text" FontWeight="Bold" FontStyle="Italic"/>
                        </Span>
                    </TextBlock>
                </MenuItem.Header>-->
                <MenuItem.Icon>
                    <Image Source="Assets/32x/edit.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Re_scan" Click="RescanButton_Click" FontFamily="Lato Light" Foreground="White" Template="{DynamicResource FuzionMenuItem}" FontSize="14">
                <MenuItem.Icon>
                    <Image Source="Assets/32x/rescan.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Locked"
                      IsCheckable="True" 
                      IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=IsGridLocked, Mode=TwoWay}" 
                      FontFamily="Lato Light"
                      FontSize="14"
                      Foreground="White" 
                      Template="{DynamicResource FuzionMenuItem}">
            </MenuItem>
            <MenuItem Header="Se_ttings" Click="SettingsButton_Click" FontFamily="Lato Light" Foreground="White" Template="{DynamicResource FuzionMenuItem}" FontSize="14">
                <MenuItem.Icon>
                    <Image Source="Assets/32x/settings.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <!--<MenuItem Header="Uninstall" Click="UninstallButton_Click" FontFamily="Lato Light" Foreground="White" Template="{DynamicResource FuzionMenuItem}" FontSize="14"/>-->
            <MenuItem Header="E_xit" Click="ExitDockButton_Click" FontFamily="Lato Light" Foreground="White" Template="{DynamicResource FuzionMenuItem}" FontSize="14">
                <MenuItem.Icon>
                    <Image Source="Assets/32x/exit.png"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <ContextMenu Style="{StaticResource FuzionContextMenu}" x:Key="DummyButtonContextMenu" Background="#FF2E2E2E">
            <MenuItem Header="_Add" Click="AddGameButton_Click" FontFamily="Lato Light" Foreground="White" Template="{DynamicResource FuzionMenuItem}" FontSize="14">
                <MenuItem.Icon>
                    <Image Source="Assets/32x/add.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Re_scan" Click="RescanButton_Click" FontFamily="Lato Light" Foreground="White" Template="{DynamicResource FuzionMenuItem}" FontSize="14">
                <MenuItem.Icon>
                    <Image Source="Assets/32x/rescan.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Se_ttings" Click="SettingsButton_Click" FontFamily="Lato Light" Foreground="White" Template="{DynamicResource FuzionMenuItem}" FontSize="14">
                <MenuItem.Icon>
                    <Image Source="Assets/32x/settings.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="E_xit" Click="ExitButton_Click" FontFamily="Lato Light" Foreground="White" Template="{DynamicResource FuzionMenuItem}" FontSize="14">
                <MenuItem.Icon>
                    <Image Source="Assets/32x/exit.png"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <Style x:Key="GameButtonStyleZoom" TargetType="Image">
            <Style.Triggers>
                <EventTrigger RoutedEvent="Image.MouseEnter">
                    <EventTrigger.Actions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width" 
                To="128" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetProperty="Height" 
                To="128" Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger.Actions>
                </EventTrigger>
                <EventTrigger RoutedEvent="Image.MouseLeave">
                    <EventTrigger.Actions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width" 
                To="108" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetProperty="Height" 
                To="108" Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger.Actions>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseDown">
                    <EventTrigger.Actions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                To="0" Duration="0:0:1" AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger.Actions>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="LoaderBackgroundFadeTop">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)" Storyboard.TargetName="image">
                <EasingDoubleKeyFrame KeyTime="0" Value="-49.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="-1.5"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)" Storyboard.TargetName="loadingLabel">
                <EasingDoubleKeyFrame KeyTime="0" Value="-49.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="-1.5"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="image">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="loadingLabel">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <local:PercentageOfElement x:Key="PercentageOfElementConverter"/>
        <local:ScrollViewerBackgroundColor x:Key="ScrollViewerBackgroundColorConverter"/>
        <sys:Double x:Key="10%">0.1</sys:Double>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <!--<BeginStoryboard>
                <BeginStoryboard.Storyboard>
                    <Storyboard>
                        -->
