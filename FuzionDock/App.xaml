        <ControlTemplate x:Key="FuzionMenuItem" TargetType="{x:Type MenuItem}">
            <!-- Menu item corner radius -->
            <Border x:Name="templateRoot" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="8,0,8,8" BorderThickness="0" Background="Transparent" SnapsToDevicePixels="True">
                <Grid Margin="10,5,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="14" SharedSizeGroup="MenuItemIconColumnGroup" Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*" MinWidth="100"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition SharedSizeGroup="MenuItemIGTColumnGroup" Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="Icon" Content="{TemplateBinding Icon}" ContentSource="Icon" HorizontalAlignment="Center" Height="32" Width="32" Margin="0,0,5,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center" />
                    <Border x:Name="GlyphPanel" CornerRadius="8" BorderBrush="#FF26A0DA" BorderThickness="0" Background="#33FFFFFF" ClipToBounds="False" HorizontalAlignment="Center" Height="32" Margin="0,0,5,0" Visibility="Hidden" VerticalAlignment="Center" Width="32">

                    </Border>
                    <Viewbox Height="24" Width="24" Margin="0,3,5,0">
                        <Path x:Name="Glyph" Data="F1M10,1.2L4.7,9.1 4.5,9.1 0,5.2 1.3,3.5 4.3,6.1 8.3,0 10,1.2z" Fill="White" FlowDirection="LeftToRight" Height="11" Width="10" Visibility="Hidden"/>
                    </Viewbox>
                 
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="menuHeaderContainer"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Content="{TemplateBinding Header}"
                                      Grid.Column="0" 
                                      ContentStringFormat="{TemplateBinding HeaderStringFormat}" 
                                      ContentSource="Header" 
                                      HorizontalAlignment="Left" 
                                      Margin="{TemplateBinding Padding}" 
                                      RecognizesAccessKey="True" 
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                      VerticalAlignment="Center"
                                      Width="50">
                        </ContentPresenter>
                        <ContentPresenter x:Name="gameNameHeaderContainer"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Content="{TemplateBinding Tag}"
                                      Grid.Column="1" 
                                      ContentStringFormat="{TemplateBinding HeaderStringFormat}" 
                                      ContentSource="Header" 
                                      HorizontalAlignment="Left"
                                      Margin="-22,-4,0,0"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                      VerticalAlignment="Center"
                                      Width="70">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"></Setter>
                                    <Setter Property="FontFamily" Value="Segoe UI"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                   
                    <TextBlock x:Name="menuGestureText" Grid.Column="4" Margin="{TemplateBinding Padding}" Opacity="0.7" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Icon" Value="{x:Null}">
                    <Setter Property="Visibility" TargetName="Icon" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Visibility" TargetName="Glyph" Value="Visible"/>
                    <Setter Property="Visibility" TargetName="Icon" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="IsCheckable" Value="True">
                    <Setter Property="Visibility" TargetName="GlyphPanel" Value="Visible"/>
                    <Setter Property="Background" TargetName="GlyphPanel" Value="#33FFFFFF"/>
                </Trigger>
                <!-- Menu item background settings -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" TargetName="templateRoot" Value="#33FFFFFF"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <!--<Trigger.EnterActions>
                        <BeginStoryboard x:Name="AnimateOnMouseOver" HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="templateRoot" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" From="#0012A012" To="#FF2FAA34" Duration="0:0:0.1" >
                                    <ColorAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn"/>
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard x:Name="AnimateOnMouseOut" HandoffBehavior="Compose">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="templateRoot" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" From="#FF2FAA34" To="#0012A012" Duration="0:0:0.1" >
                                    <ColorAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn"/>
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>-->
                    <Setter Property="Background" TargetName="templateRoot" Value="#19FFFFFF">
                        <!--<Setter.Value>
                            <LinearGradientBrush Opacity="0.5" EndPoint="0.5,1" StartPoint="0.5,0">
                                <LinearGradientBrush.RelativeTransform>
                                    <TransformGroup>
                                        <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                        <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                        <RotateTransform CenterY="0.5" CenterX="0.5" Angle="65"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="#FF18BF5C" Offset="0"/>
                                <GradientStop Color="#FF58A7D4" Offset="1"/>
                                <GradientStop Color="#FF1FDEDE" Offset="0.5"/>
                            </LinearGradientBrush>
                        </Setter.Value>-->
                    </Setter>
                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="#FF26A0DA"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="TextElement.Foreground" TargetName="templateRoot" Value="#FF707070"/>
                    <Setter Property="Fill" TargetName="Glyph" Value="#FF707070"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsHighlighted" Value="True"/>
                        <Condition Property="IsEnabled" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" TargetName="templateRoot" Value="#0A000000"/>
                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="#21000000"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <SolidColorBrush x:Key="ListBox.Static.Background" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ListBox.Static.Border" Color="#FFABADB3"/>
        <SolidColorBrush x:Key="ListBox.Disabled.Background" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ListBox.Disabled.Border" Color="#FFD9D9D9"/>
        <Style x:Key="RoundedListBox" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{StaticResource ListBox.Static.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ListBox.Static.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
            <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border CornerRadius="0,0,10,10" x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="1" SnapsToDevicePixels="true">
                            <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBox.Disabled.Background}"/>
                                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBox.Disabled.Border}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsGrouping" Value="true"/>
                                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--MAIN GAME BUTTON STYLE-->
        <!--<SolidColorBrush x:Key="Game.ShadowColor" Color="White"/>-->
        <Color x:Key="Game.ShadowColor" R="255" G="255" B="255" A="255"/>
        <Style x:Key="GameButtonStyleStatic" TargetType="Image">
            <Style.Setters>
                <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
                <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
                <Setter Property="ToolTipService.ShowDuration" Value="300000"/>
                <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" x:Name="GameScaleTransform"/>
                            <TranslateTransform x:Name="GameTranslateTransform"/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>

            </Style.Setters>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <!--<Trigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource GameGrowAnimation}"/>
                    </Trigger.EnterActions>-->
                    <Trigger.Setters>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <!--Color="{Binding Source={x:Static properties:Settings.Default}, Path=GameShadowOutlineColor}-->
                                <!--Bigger blurradius looks good-->
                                <DropShadowEffect Color="{DynamicResource Game.ShadowColor}" Opacity="1" ShadowDepth="0" BlurRadius="5" RenderingBias="Performance" />
                            </Setter.Value>
                        </Setter>
                    </Trigger.Setters>
                </Trigger>
                <!--Game Grow On Loaded-->
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <EventTrigger.Actions>
                        <BeginStoryboard Storyboard="{DynamicResource GameGrowAnimation}"/>
                    </EventTrigger.Actions>
                </EventTrigger>
                <!--<EventTrigger RoutedEvent="MouseLeftButtonDown">
                    <EventTrigger.Actions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                To="0.5" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="3x"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger.Actions>
                </EventTrigger>-->
                <EventTrigger RoutedEvent="MouseRightButtonDown">
                    <EventTrigger.Actions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                To="0.5" Duration="0:0:0.2" AutoReverse="True" RepeatBehavior="1x"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger.Actions>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="GameGrowAnimationDelayedForStartup">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                <!--(UIElement.RenderTransform).(ScaleTransform.ScaleX)-->
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <!--adds a delay-->
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="1.1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <!--adds a delay-->
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="1.1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="GameGrowAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                <!--(UIElement.RenderTransform).(ScaleTransform.ScaleX)-->
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <!--adds a delay-->
                <!--<EasingDoubleKeyFrame KeyTime="0:0:1" Value="0"/>-->
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <!--adds a delay-->
                <!--<EasingDoubleKeyFrame KeyTime="0:0:1" Value="0"/>-->
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="GameShrinkAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                <!--(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)-->
                <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                <!--adds a delay-->
                <!--<EasingDoubleKeyFrame KeyTime="0:0:1" Value="0"/>-->
                <!--<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.1"/>-->
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/> <!--def 0:0:0.2-->
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                <!--(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)-->
                <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                <!--adds a delay-->
                <!--<EasingDoubleKeyFrame KeyTime="0:0:1" Value="0"/>-->
                <!--<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.1"/>-->
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/><!--def 0:0:0.2-->
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="GameFadeOutInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(Image.Opacity)" From="1" To="0" Duration="0:0:0.15" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="GameFadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(Image.Opacity)" From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="GameFadeOutAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(Image.Opacity)" From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="GameSlideLeftAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" From="0" To="1" Duration="0:0:0.1"/>
        </Storyboard>

        <Storyboard x:Key="GameSlideRightAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" From="0" To="1" Duration="0:0:0.1"/>
        </Storyboard>

        <Storyboard x:Key="GameLaunchAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(Image.Opacity)" From="1" To="0.5" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="5x"/>
        </Storyboard>

        <Storyboard x:Key="BorderBackgroundColorAnimation" RepeatBehavior="5x">
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextBox.Foreground).(GradientBrush.GradientStops)[0].(GradientStop.Color)" Storyboard.TargetName="DebugTextBox">
                <EasingColorKeyFrame KeyTime="0" Value="#FF7DD4AD"/>
                <EasingColorKeyFrame KeyTime="0:0:1" Value="#FFE7A5EE"/>
                <EasingColorKeyFrame KeyTime="0:0:2" Value="#FF6BDADA"/>
                <EasingColorKeyFrame KeyTime="0:0:3" Value="#FF7DD4AD"/>
            </ColorAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(TextBox.Foreground).(Brush.RelativeTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)" Storyboard.TargetName="DebugTextBox">
                <EasingDoubleKeyFrame KeyTime="0" Value="65"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(TextBox.Foreground).(GradientBrush.GradientStops)[2].(GradientStop.Offset)" Storyboard.TargetName="DebugTextBox">
                <EasingDoubleKeyFrame KeyTime="0" Value="0.5"/>
            </DoubleAnimationUsingKeyFrames>
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextBox.Foreground).(GradientBrush.GradientStops)[2].(GradientStop.Color)" Storyboard.TargetName="DebugTextBox">
                <EasingColorKeyFrame KeyTime="0" Value="#FF6BDADA"/>
                <EasingColorKeyFrame KeyTime="0:0:1" Value="#FF7DD4AD"/>
                <EasingColorKeyFrame KeyTime="0:0:2" Value="#FFE7A5EE"/>
                <EasingColorKeyFrame KeyTime="0:0:3" Value="#FF6BDADA"/>
            </ColorAnimationUsingKeyFrames>
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextBox.Foreground).(GradientBrush.GradientStops)[1].(GradientStop.Color)" Storyboard.TargetName="DebugTextBox">
                <EasingColorKeyFrame KeyTime="0" Value="#FFE7A5EE"/>
                <EasingColorKeyFrame KeyTime="0:0:1" Value="#FF6BDADA"/>
                <EasingColorKeyFrame KeyTime="0:0:2" Value="#FF7DD4AD"/>
                <EasingColorKeyFrame KeyTime="0:0:3" Value="#FFE7A5EE"/>
            </ColorAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="BorderGradientAnimation" RepeatBehavior="1x">
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)">
                <EasingColorKeyFrame KeyTime="0" Value="#FF7DD4AD"/>
                <EasingColorKeyFrame KeyTime="0:0:0.5" Value="#FFE7A5EE"/>
                <EasingColorKeyFrame KeyTime="0:0:1" Value="#FF6BDADA"/>
                <EasingColorKeyFrame KeyTime="0:0:1.5" Value="#FF7DD4AD"/>
            </ColorAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
                <EasingDoubleKeyFrame KeyTime="0" Value="65"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[2].(GradientStop.Offset)">
                <EasingDoubleKeyFrame KeyTime="0" Value="0.5"/>
            </DoubleAnimationUsingKeyFrames>
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[2].(GradientStop.Color)">
                <EasingColorKeyFrame KeyTime="0" Value="#FF6BDADA"/>
                <EasingColorKeyFrame KeyTime="0:0:0.5" Value="#FF7DD4AD"/>
                <EasingColorKeyFrame KeyTime="0:0:1" Value="#FFE7A5EE"/>
                <EasingColorKeyFrame KeyTime="0:0:1.5" Value="#FF6BDADA"/>
            </ColorAnimationUsingKeyFrames>
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)">
                <EasingColorKeyFrame KeyTime="0" Value="#FFE7A5EE"/>
                <EasingColorKeyFrame KeyTime="0:0:0.5" Value="#FF6BDADA"/>
                <EasingColorKeyFrame KeyTime="0:0:1" Value="#FF7DD4AD"/>
                <EasingColorKeyFrame KeyTime="0:0:1.5" Value="#FFE7A5EE"/>
            </ColorAnimationUsingKeyFrames>
        </Storyboard>

        <SolidColorBrush x:Key="TextBox.Static.Border" Color="#FFABAdB3"/>
        <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#FF7EB4EA"/>
        <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#FF569DE5"/>
        <Style x:Key="AnimatedSearchTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextBox.Static.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AllowDrop" Value="true"/>
            <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border CornerRadius="10" x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--<EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard Storyboard="{DynamicResource SearchBoxShrink}" />
                            </EventTrigger>-->
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.MouseOver.Border}"/>
                            </Trigger>
                            <!--<Trigger Property="IsMouseOver" Value="false">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{DynamicResource SearchBoxShrink}"/>
                                </Trigger.EnterActions>
                            </Trigger>-->
                            <!-- Focus Triggers -->


                            <!--<Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.Focus.Border}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{DynamicResource SearchBoxExpand}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{DynamicResource SearchBoxShrink}"/>
                                </Trigger.ExitActions>
                            </Trigger>-->

                            <!--<Trigger Property="IsKeyboardFocused" Value="false">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{DynamicResource SearchBoxShrink}"/>
                                </Trigger.EnterActions>
                            </Trigger>-->
                            <!--<Trigger Property="IsFocused" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.Focus.Border}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{DynamicResource SearchBoxExpand}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{DynamicResource SearchBoxShrink}"/>
                                </Trigger.ExitActions>
                            </Trigger>-->

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                        <Condition Property="IsSelectionActive" Value="false"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Storyboard x:Key="SearchBoxExpand">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Width)">
                <!--<EasingThicknessKeyFrame KeyTime="0" Value="200,0"/>
                <EasingThicknessKeyFrame KeyTime="0:0:0.2" Value="112,0"/>-->
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="200"/>
            </DoubleAnimationUsingKeyFrames>
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
                <EasingColorKeyFrame KeyTime="0" Value="Transparent"/>
                <EasingColorKeyFrame KeyTime="0:0:0.2" Value="White"/>
                <!--was #4CFFFFFF-->
            </ColorAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="SearchBoxShrink">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Width)">
                <!--<EasingThicknessKeyFrame KeyTime="0" Value="112,0"/>
                <EasingThicknessKeyFrame KeyTime="0:0:0.2" Value="200,0"/>-->
                <EasingDoubleKeyFrame KeyTime="0" Value="200"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
                <EasingColorKeyFrame KeyTime="0" Value="White"/>
                <EasingColorKeyFrame KeyTime="0:0:0.2" Value="Transparent"/>
                <!--was #4CFFFFFF-->
            </ColorAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="OnlineIconsExpandBorder">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="0" Value="180"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="240"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="OnlineIconsShrinkBorder">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="0" Value="240"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="180"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="HighlightEditGameWindowBorder">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.Opacity)">
