        <Style x:Key="FuzionOpacityButton" TargetType="{x:Type Image}">
            <Style.Setters>
                <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
