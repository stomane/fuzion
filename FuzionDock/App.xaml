                            <TranslateTransform/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
            </Style.Setters>
            <Style.Triggers>
                <EventTrigger RoutedEvent="UIElement.MouseDown">
                    <BeginStoryboard Name="OpacityClickStoryboard">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="{StaticResource FuzionOpacityButton.Default}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="{StaticResource FuzionOpacityButton.Click}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="{StaticResource FuzionOpacityButton.Default}"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Opacity" Value="{StaticResource FuzionOpacityButton.MouseOver}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="false">
                    <Setter Property="Opacity" Value="{StaticResource FuzionOpacityButton.Default}"/>
                </Trigger>
                <!--<DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=IsVisible}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{DynamicResource GameGrowAnimation}"/>
                    </DataTrigger.EnterActions>
                </DataTrigger>-->
            </Style.Triggers>
        </Style>


        <Style x:Key="WidgetCheckBox" TargetType="{x:Type CheckBox}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Background" Value="{StaticResource OptionMark.Static.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OptionMark.Static.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="checkBoxBorder" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TransformGroup>
                                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                                <RotateTransform Angle="45" CenterY="0.5" CenterX="0.5"/>
                                                <TranslateTransform/>
                                            </TransformGroup>
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop x:Name="GradientStop0" Color="#3FFFFFFF" Offset="0"/>
                                        <GradientStop x:Name="GradientStop1" Color="#7FFFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid x:Name="markGrid">
                                    <Path Visibility="Hidden" x:Name="optionMark" Data="F1 M 9.97498,1.22334L 4.6983,9.09834L 4.52164,9.09834L 0,5.19331L 1.27664,3.52165L 4.255,6.08833L 8.33331,1.52588e-005L 9.97498,1.22334 Z " Fill="{StaticResource OptionMark.Static.Glyph}" Margin="1" Opacity="0" Stretch="None"/>
                                    <Rectangle Visibility="Hidden" x:Name="indeterminateMark" Fill="{StaticResource OptionMark.Static.Glyph}" Margin="2" Opacity="0"/>
                                </Grid>
                            </Border>
                            <Grid Name="insideContentGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.5*"/>
                                    <RowDefinition Height="2*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!--Source="{TemplateBinding Background.ImageBrush.ImageSource}"-->
                                <Image Name="widgetIcon" 
                                       Grid.Row="1"
                                        Source="{TemplateBinding Tag}"
                                        Width="36"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                </Image>
                                <ContentPresenter 
                                    x:Name="contentPresenter" 
                                    Grid.Row="2" 
                                    Focusable="False" 
                                    HorizontalAlignment="Center"
                                    Margin="0"
                                    RecognizesAccessKey="True" 
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                    VerticalAlignment="Center"
                                    TextBlock.Foreground="White"
                                    TextBlock.FontFamily="Lato Light">
                                    <!--<ContentPresenter.Effect>
                                        <DropShadowEffect Direction="-45" BlurRadius="2" ShadowDepth="1" Opacity="0.7"/>
                                    </ContentPresenter.Effect>-->
                                </ContentPresenter>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Resources>
                            <Color x:Key="Widget.Checkbox.Checked.One">#E52E92CB</Color>
                            <Color x:Key="Widget.Checkbox.Checked.Two">#E5C2E2AB</Color>
                            <Color x:Key="Widget.Checkbox.Unchecked.One">#33FFFFFF</Color>
                            <Color x:Key="Widget.Checkbox.Unchecked.Two">#3FFFFFFF</Color>
                            <Storyboard x:Key="checkedStoryboardKey" FillBehavior="HoldEnd">
                                <!--<ColorAnimation Duration="0:0:0.5" To="Purple" Storyboard.TargetName="checkBoxBorder" Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)"/>-->
                                <ColorAnimationUsingKeyFrames Storyboard.TargetName="checkBoxBorder" Storyboard.TargetProperty="(Panel.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)">
                                    <EasingColorKeyFrame KeyTime="0" Value="{StaticResource Widget.Checkbox.Unchecked.One}"/>
                                    <EasingColorKeyFrame KeyTime="0:0:0.1" Value="{StaticResource Widget.Checkbox.Checked.One}"/>
                                </ColorAnimationUsingKeyFrames>
                                <ColorAnimationUsingKeyFrames Storyboard.TargetName="checkBoxBorder" Storyboard.TargetProperty="(Panel.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)">
                                    <EasingColorKeyFrame KeyTime="0:0:0.1" Value="{StaticResource Widget.Checkbox.Unchecked.Two}"/>
                                    <EasingColorKeyFrame KeyTime="0:0:0.2" Value="{StaticResource Widget.Checkbox.Checked.Two}"/>
                                </ColorAnimationUsingKeyFrames>
                            </Storyboard>
                            <Storyboard x:Key="uncheckedStoryboardKey" FillBehavior="HoldEnd">
                                <ColorAnimationUsingKeyFrames Storyboard.TargetName="checkBoxBorder" Storyboard.TargetProperty="(Panel.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)">
                                    <EasingColorKeyFrame KeyTime="0" Value="{StaticResource Widget.Checkbox.Checked.Two}"/>
                                    <EasingColorKeyFrame KeyTime="0:0:0.1" Value="{StaticResource Widget.Checkbox.Unchecked.Two}"/>
                                </ColorAnimationUsingKeyFrames>
                                <ColorAnimationUsingKeyFrames Storyboard.TargetName="checkBoxBorder" Storyboard.TargetProperty="(Panel.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)">
                                    <EasingColorKeyFrame KeyTime="0:0:0.1" Value="{StaticResource Widget.Checkbox.Checked.One}"/>
                                    <EasingColorKeyFrame KeyTime="0:0:0.2" Value="{StaticResource Widget.Checkbox.Unchecked.One}"/>
                                </ColorAnimationUsingKeyFrames>
                            </Storyboard>
                        </ControlTemplate.Resources>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="True">
                                <DataTrigger.EnterActions>
                                    <RemoveStoryboard BeginStoryboardName="uncheckedStoryboardName"/>
                                    <BeginStoryboard x:Name="checkedStoryboardName" Storyboard="{StaticResource checkedStoryboardKey}"/>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="False">
                                <DataTrigger.EnterActions>
                                    <RemoveStoryboard BeginStoryboardName="checkedStoryboardName"/>
                                    <BeginStoryboard x:Name="uncheckedStoryboardName" Storyboard="{StaticResource uncheckedStoryboardKey}"/>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <Trigger Property="HasContent" Value="true">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource OptionMarkFocusVisual}"/>
                                <Setter Property="Padding" Value="4,-1,0,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Opacity" TargetName="checkBoxBorder" Value="1"/>
                                <!--<Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.MouseOver.Background}"/>
                                <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.MouseOver.Border}"/>
                                <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource OptionMark.MouseOver.Glyph}"/>
                                <Setter Property="Fill" TargetName="indeterminateMark" Value="{StaticResource OptionMark.MouseOver.Glyph}"/>-->
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="false">
                                <Setter Property="Opacity" TargetName="checkBoxBorder" Value="0.8"/>
                                <!--<Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.MouseOver.Background}"/>
                                <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.MouseOver.Border}"/>
                                <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource OptionMark.MouseOver.Glyph}"/>
                                <Setter Property="Fill" TargetName="indeterminateMark" Value="{StaticResource OptionMark.MouseOver.Glyph}"/>-->
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" TargetName="widgetIcon" Value="0.5"/>
                                <Setter Property="Opacity" TargetName="contentPresenter" Value="0.5"/>
                                <Setter Property="Opacity" TargetName="checkBoxBorder" Value="0.1"/>
                                <!--<Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Disabled.Background}"/>-->
                                <!--<Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Disabled.Background}"/>-->
                                <!--<Setter Property="Fill" TargetName="optionMark" Value="{StaticResource OptionMark.Disabled.Glyph}"/>-->
                                <!--<Setter Property="Fill" TargetName="indeterminateMark" Value="{StaticResource OptionMark.Disabled.Glyph}"/>-->
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Opacity" TargetName="checkBoxBorder" Value="0.8"/>
                                <!--<Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Pressed.Background}"/>
                                <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Pressed.Border}"/>
                                <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource OptionMark.Pressed.Glyph}"/>
                                <Setter Property="Fill" TargetName="indeterminateMark" Value="{StaticResource OptionMark.Pressed.Glyph}"/>-->
                            </Trigger>
                            <!--<Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="#E5C2E2AB" Offset="0"/>
                                            <GradientStop Color="#E52E92CB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>-->
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter Property="Opacity" TargetName="optionMark" Value="0"/>
                                <Setter Property="Opacity" TargetName="indeterminateMark" Value="1"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
