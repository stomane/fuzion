<Window x:Class="Fuzion.WindowsManager.FuzionToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fuzion.WindowsManager"
        mc:Ignorable="d"
        Title="FuzionToastWindow" 
        Height="200" 
        Width="410"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="Transparent"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Focusable="False">
    <Grid>
        <Border CornerRadius="{StaticResource Window.CornerRadius}"
                Margin="10"
                BorderThickness="1"
                BorderBrush="DimGray">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform CenterY="0.5" CenterX="0.5" Angle="65"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF05323A" Offset="0"/>
                    <GradientStop Color="#FF0C443B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Opacity="{StaticResource DropShadow.Opacity}" RenderingBias="Performance"/>
            </Border.Effect>
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" MinHeight="30" MaxHeight="30"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="{Binding MessageTitle}"
               Foreground="White"
               FontFamily="Lato"
               VerticalAlignment="Top"
               VerticalContentAlignment="Center"
               Height="30" 
               FontSize="16">
                </Label>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding ImageSrc}" Grid.Column="0" Visibility="Collapsed"/>
                    <!--{Binding MessageText}-->
                    <TextBlock Grid.Column="1" Text="{Binding MessageText}"
                   Foreground="White"
                   FontFamily="Lato Light"
                   FontSize="14"
                   TextWrapping="Wrap"
                   TextAlignment="Left">
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>
        


    </Grid>
</Window>
