<Window x:Class="Fuzion.WindowsManager.FuzionNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fuzion.WindowsManager"
        mc:Ignorable="d"
        Title="FuzionNotificationWindow" 
        Height="200" 
        Width="410"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        Mouse.MouseDown="Window_Drag"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True">
    <Grid>
        <!--<Border Name="FakeBlurBorder" 
                CornerRadius="8,0,8,8"
                Opacity="0.9"
                Margin="10">
            <Border.Background>
                <ImageBrush Stretch="UniformToFill" ImageSource="/Fuzion;component/Assets/fake_blur.png"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Opacity="{StaticResource DropShadow.Opacity}" RenderingBias="Performance"/>
            </Border.Effect>
        </Border>-->
        <Border CornerRadius="{StaticResource Window.CornerRadius}"
                Margin="10"
                BorderThickness="1"
                BorderBrush="DimGray">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform CenterY="0.5" CenterX="0.5" Angle="65"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF05323A" Offset="0"/>
                    <GradientStop Color="#FF0C443B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Opacity="{StaticResource DropShadow.Opacity}" RenderingBias="Performance"/>
            </Border.Effect>
        </Border>
        <Border Width="42" 
                Height="30" 
                CornerRadius="0"
                BorderThickness="0" 
                Style="{StaticResource FuzionBorderCloseButton}"
                VerticalAlignment="Top" 
                HorizontalAlignment="Right"
                Name="CloseWindow"
                Margin="0,10,10,0">
            <Image Margin="8" 
                   Opacity="1"
                   Source="/Fuzion;component/Assets/32x/slimCloseIcon.png"/>
        </Border>
        <CheckBox Style="{StaticResource WidgetCheckBox}"
                  Name="BlacklistCheckbox"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch" 
                  Margin="16,165,360,16"
                  Visibility="Hidden"
                  IsChecked="{Binding IsBlacklistChecked, Mode=OneWayToSource}"
                  BorderThickness="0"/>
        <Label Content="Blacklist"
               Name="BlacklistLabel"
               Foreground="White"
               FontFamily="Lato Light" 
               Margin="50,162,267,12"
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Left"
               FontSize="14"
               Visibility="Hidden"/>
        <Button Content="{Binding AcceptButtonText}"
                Style="{StaticResource FuzionTransparentButton}"
                Margin="191,0,119,16"
                FontFamily="Lato Light"
                FontSize="14"
                Background="#19FFFFFF"
                Foreground="White"
                Height="30"
                Width="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                IsDefault="True"
                Click="OkButton_Click">
        </Button>
        <TextBlock Text="{Binding MessageText}"
                   Foreground="White"
                   FontFamily="Lato Light"
                   FontSize="14"
                   Margin="36,48,36,56"
                   TextWrapping="Wrap"
                   TextAlignment="Left">
        </TextBlock>
        <Label Content="{Binding MessageTitle}"
               Foreground="White"
               FontFamily="Lato"
               VerticalAlignment="Top"
               VerticalContentAlignment="Center"
               Height="30" 
               Margin="20,14,57,0"
               FontSize="16">
        </Label>
        <Button Content="{Binding CancelButtonText}"
            Style="{StaticResource FuzionTransparentButton}"
            Visibility="{Binding IsCancelVisible}"
            Margin="296,0,16,16"
            FontFamily="Lato Light"
            FontSize="14"
            Background="#19FFFFFF"
            Foreground="White"
            Height="30"
            Width="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            IsCancel="True"
            Click="CancelButton_Click"/>
    </Grid>
</Window>
