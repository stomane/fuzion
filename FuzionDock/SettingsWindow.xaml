                                Foreground="White"
                                FontSize="12"
                                Grid.Column="1"
                                Click="SelectAllBlacklistButton_Click"/>
                        <Button Content="Deselect All"
                                Margin="4"
                                Style="{StaticResource FuzionTransparentButton}"
                                Background="#19FFFFFF"
                                Foreground="White"
                                FontSize="12"
                                Grid.Column="2"
                                Click="DeselectAllBlacklistButton_Click"/>
                        <Button Style="{StaticResource FuzionTransparentButton}"
                                Name="RemoveFromBlacklistButton"
                                Margin="2"
                                Background="#19FFFFFF"
                                Foreground="White"
                                Grid.Column="3"
                                Click="RemoveFromBlacklistButton_Click"
                                ToolTip="Remove">
                            <Button.Content>
                                <Image Grid.Column="1"
                                       Margin="2"
                                       Source="Assets/32x/remove.png"
                                       HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button.Content>
                        </Button>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!--Old close button using 2 elements-->

