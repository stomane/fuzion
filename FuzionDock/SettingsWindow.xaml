                            </Path>-->
                        </Grid>
                    </StackPanel>
                    <!--#region Hidden-->
                    <CheckBox Visibility="Hidden"
                              Style="{StaticResource RoundedCheckBox}"
                              IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=OpenDebugWindow, Mode=TwoWay}"
                              x:Name="DebugCheckBox" 
                              Content="Debug" 
                              HorizontalAlignment="Left"  
                              VerticalAlignment="Center" 
                              Foreground="White" 
                              FontFamily="Lato Light" 
                              FontSize="14" 
                              ToolTip="Open debug window on startup"/>
                    <CheckBox Visibility="Hidden"
                              Click="ShowUnhandledExceptions_Click"
                              IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=ShowUnhandled, Mode=TwoWay}" 
                              Style="{StaticResource RoundedCheckBox}" 
                              x:Name="ShowUnhandledExceptions" 
                              Content="Show exceptions"
                              HorizontalAlignment="Left" 
                              VerticalAlignment="Center"
                              Foreground="White" 
                              FontFamily="Lato Light"
                              FontSize="14" 
                              ToolTip="Display a window with the stack trace when an unhandled exception occurs. Used for debugging"/>
                    <!--#endregion-->


                </Grid>
            </TabItem>
            <!-- Dock Tab Item Start -->
            <TabItem Visibility="Visible"
                     Background="Transparent"
                     Foreground="White" 
                     FontFamily="Lato Light"
                     FontSize="14" 
                     Header="Dock" 
                     BorderBrush="{x:Null}" 
                     Style="{DynamicResource TabItemTransparent}" 
                     BorderThickness="0">
                <ScrollViewer x:Name="DockTabScrollViewer"
                              PreviewMouseDown="DockTabScrollViewer_PreviewMouseDown"
                              PreviewMouseUp="DockTabScrollViewer_PreviewMouseUp"
                              PreviewMouseWheel="DockTabScrollViewer_PreviewMouseWheel" Template="{DynamicResource MarginScrollViewer}"
                              >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" CanVerticallyScroll="True">
                            <Grid MaxHeight="{StaticResource StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        Content="Icon Size"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"/>
                                <TextBlock Visibility="Visible"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right" 
                                   TextWrapping="Wrap" 
                                   Text="{Binding Value, ElementName=iconSizeSlider}" 
                                   VerticalAlignment="Center" 
                                   Foreground="White" 
                                   FontFamily="Lato Light" 
                                   FontSize="14"
                                   TextAlignment="Center" />
                                <Slider Visibility="Visible"
                                Grid.Column="2"
                                x:Name="iconSizeSlider" 
                                Style="{StaticResource RoundedSlider}"
                                    FocusVisualStyle="{StaticResource FocusVisual}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="White" 
                                ValueChanged="Slider_ValueChanged" 
                                Minimum="32" 
                                Maximum="180" 
                                SmallChange="1"
                                LargeChange="5" 
                                IsSnapToTickEnabled="True"/>
                            </Grid>
                            <Grid MaxHeight="{Binding StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Content="Style Manually Added Icons"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"
                        ToolTip="Crops and frames manually added icons if they don't match the circular design"/>
                                <CheckBox IsChecked="{Binding CropManuallyAddedIcons, Mode=TwoWay, Source={x:Static properties:Settings.Default}}"
                                  Grid.Column="1"
                                  Style="{StaticResource WidgetCheckBox}"
                                  x:Name="CropManuallyAddedIcons"
                                  BorderThickness="0"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch"
                                  Content=""
                                  FontSize="14"/>
                            </Grid>
                            <Grid MaxHeight="{Binding StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Content="Fetch Online Icons"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"
                        ToolTip="Disable this if you want to use system icons only"/>
                                <CheckBox IsChecked="{Binding FetchOnlineIcon, Mode=TwoWay, Source={x:Static properties:Settings.Default}}"
                                  Grid.Column="1"
                                  Style="{StaticResource WidgetCheckBox}"
                                  BorderThickness="0"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch"
                                  Content=""
                                  FontSize="14"/>
                            </Grid>
                            <Grid MaxHeight="{Binding StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Content="Edge Fade"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"
                        ToolTip="Fade icons near the edges"/>
                                <CheckBox IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=DockEdgeFadeEnabled, Mode=TwoWay}"
                                  Grid.Column="1"
                                  Style="{StaticResource WidgetCheckBox}"
                                  BorderThickness="0"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch"
                                  Content=""
                                  FontSize="14"
                                  Checked="EdgeFade_Toggled"
                                  Unchecked="EdgeFade_Toggled"/>
                            </Grid>
                            <!--Icon Relevance is now locked to 5-->
                            <Grid Visibility="Collapsed" 
                            MaxHeight="{Binding StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Content="Icon Relevance"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"
                        ToolTip="Fuzion will attempt to find better icons the higher this value is set.&#10;If you have a slow network connection you might&#10; want to choose Low or Medium icon relevance."/>
                                <ComboBox
                        Grid.Column="1"
                        x:Name="IconRelevance" 
                              SelectionChanged="IconRelevance_SelectionChanged"
                              HorizontalContentAlignment="Left" 
                              VerticalContentAlignment="Center"
                              Foreground="White" 
                              Background="Transparent" 
                              BorderBrush="White" 
                              BorderThickness="0" 
                              FontFamily="Lato Light" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch"
                              FontSize="14" 
                              Style="{DynamicResource FuzionTransparentComboBox}"
                            Width="{StaticResource ComboBoxDesignatedWidth}">
                                    <ComboBoxItem Content="Low" HorizontalAlignment="Right" Style="{DynamicResource FuzionComboBoxItemGreen}"/>
                                    <ComboBoxItem Content="Medium" HorizontalAlignment="Right" Style="{DynamicResource FuzionComboBoxItemGreen}"/>
                                    <ComboBoxItem Content="High" HorizontalAlignment="Right" Style="{DynamicResource FuzionComboBoxItemGreen}"/>
                                </ComboBox>
                            </Grid>
                            <Grid MaxHeight="{Binding StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Content="Icon Outline"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"
                        ToolTip="Set the highlight color when you hover over games or focus them"/>
                                <ComboBox Grid.Column="1"
                                      SelectionChanged="OutlineColorSelection_SelectionChanged"
                        SelectedIndex="{Binding Source={x:Static properties:Settings.Default}, Path=DarkGameOutline, Mode=TwoWay, Converter={StaticResource BoolToIndexConverter}}" 
                        Style="{DynamicResource FuzionTransparentComboBox}" 
                        HorizontalContentAlignment="Left" 
                        VerticalContentAlignment="Center" 
                        x:Name="OutlineColorSelection" 
                        Foreground="White" 
                        Background="Transparent"
                        BorderBrush="White"
                        BorderThickness="0" 
                        FontFamily="Lato Light"
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch"
                        Width="{StaticResource ComboBoxDesignatedWidth}"
                        FontSize="14" >
                                    <ComboBoxItem Content="Dark" Style="{DynamicResource FuzionComboBoxItemGreen}"/>
                                    <ComboBoxItem Content="Bright" Style="{DynamicResource FuzionComboBoxItemGreen}"/>
                                </ComboBox>
                            </Grid>
                            <Grid MaxHeight="{StaticResource StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Content="Click Count"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"
                        ToolTip="Single or double-click to launch a game"/>
                                <ComboBox Grid.Column="1"
                                  Style="{DynamicResource FuzionTransparentComboBox}" 
                                  SelectionChanged="LaunchClickCountDropdown_SelectionChanged"
                                  HorizontalContentAlignment="Left" 
                                  VerticalContentAlignment="Center"
                                  x:Name="launchClickCountDropdown"
                                  Foreground="White"
                                  Background="Transparent"
                                  BorderBrush="White" 
                                  BorderThickness="0"
                                  FontFamily="Lato Light"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Width="{StaticResource ComboBoxDesignatedWidth}"
                                  FontSize="14">
                                    <ComboBoxItem Content="1x" Style="{DynamicResource FuzionComboBoxItemGreen}"/>
                                    <ComboBoxItem Content="2x" Style="{DynamicResource FuzionComboBoxItemGreen}"/>
                                </ComboBox>
                            </Grid>
                            <Grid MaxHeight="{Binding StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*"/>
                                    <ColumnDefinition Width="0.25*"/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        Content="Scroll Distance"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"
                        ToolTip="Dock scrolling distance in game size. Default is 1 game length"/>
                                <TextBlock Visibility="Visible"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap"
                                   Text="{Binding ElementName=ScrollDistanceSlider, Path=Value}"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Lato Light"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                                <Slider Visibility="Visible"
                                    Name="ScrollDistanceSlider"
                                    Value="{Binding Source={x:Static properties:Settings.Default}, Path=DockScrollSpeed, Mode=TwoWay}"
                                Grid.Column="2"
                                Style="{StaticResource RoundedSlider}"
                                    FocusVisualStyle="{StaticResource FocusVisual}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="White" 
                                Minimum="0.5" 
                                Maximum="2" 
                                SmallChange="0.1"
                                LargeChange="0.5"
                                    TickFrequency="0.1"
                                IsSnapToTickEnabled="True"/>
                            </Grid>
                            <Grid MaxHeight="{Binding StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        Content="Scroll Speed"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"
                        ToolTip="Controls dock scrolling interpolation speed. Default is 0.1"/>
                                <TextBlock Visibility="Visible"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap"
                                   Text="{Binding ElementName=ScrollSpeedSlider, Path=Value}"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Lato Light"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                                <Slider Visibility="Visible"
                                    Name="ScrollSpeedSlider"
                                    Value="{Binding Source={x:Static properties:Settings.Default}, Path=ScrollLerpSpeed, Mode=TwoWay}"
                                Grid.Column="2"
                                Style="{StaticResource RoundedSlider}"
                                    FocusVisualStyle="{StaticResource FocusVisual}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="White" 
                                Minimum="0.01" 
                                Maximum="1" 
                                SmallChange="0.01"
                                LargeChange="0.1"
                                    TickFrequency="0.01"
                                IsSnapToTickEnabled="True"/>
                            </Grid>
                            <Grid MaxHeight="{Binding StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Content="Show Labels"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"
                        ToolTip="Show labels when you hover over games or select them using the keyboard or gamepad"/>
                                <CheckBox IsChecked="{Binding ShowGameLabels, Mode=TwoWay, Source={x:Static properties:Settings.Default}}"
                                  Grid.Column="1"
                                  Style="{StaticResource WidgetCheckBox}"
                                  BorderThickness="0"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch"
                                  Content=""
                                  FontSize="14"
                                      Unchecked="ShowGameLabels_Unchecked"/>
                            </Grid>
                            <Grid MaxHeight="{Binding StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Content="Scroll Edge Bounce"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"
                        ToolTip="Controls grid bounce when you scroll to the end"/>
                                <CheckBox IsChecked="{Binding BounceScroll, Mode=TwoWay, Source={x:Static properties:Settings.Default}}"
                                  Grid.Column="1"
                                  Style="{StaticResource WidgetCheckBox}"
                                  BorderThickness="0"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch"
                                  Content=""
                                  FontSize="14"/>
                            </Grid>
                            <Grid MaxHeight="{Binding StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Content="Background Auto-Size"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"
                        ToolTip="Automatically size the dock background to fit content"/>
                                <CheckBox IsChecked="{Binding BackgroundAutoSize, Mode=TwoWay, Source={x:Static properties:Settings.Default}}"
                                  Grid.Column="1"
                                  x:Name="BackgroundAutoSizeCheckbox"
                                  Style="{StaticResource WidgetCheckBox}"
                                  BorderThickness="0"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch"
                                  Content=""
                                  FontSize="14"
                                  Click="BackgroundAutoSize_Click"/>
                            </Grid>
                            <Grid MaxHeight="{Binding StackPanelRowHeight}" x:Name="BackgroundWidthGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        Content="Background Width"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"/>
                                <TextBlock Visibility="Visible"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap"
                                   Text="{Binding ElementName=BackgroundWidthSlider, Path=Value}"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Lato Light"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                                <Slider Visibility="Visible"
                                    Name="BackgroundWidthSlider"
                                    Value="{Binding Source={x:Static properties:Settings.Default}, Path=BackgroundWidth, Mode=TwoWay}"
                                Grid.Column="2"
                                Style="{StaticResource RoundedSlider}"
                                    FocusVisualStyle="{StaticResource FocusVisual}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="White" 
                                Minimum="100" 
                                Maximum="3000" 
                                SmallChange="10"
                                LargeChange="50"
                                    TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                ValueChanged="BackgroundSizeExample_ValueChanged"/>
                            </Grid>
                            <Grid MaxHeight="{Binding StackPanelRowHeight}" x:Name="BackgroundHeightGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        Content="Background Height"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"/>
                                <TextBlock Visibility="Visible"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap"
                                   Text="{Binding ElementName=BackgroundHeightSlider, Path=Value}"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Lato Light"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                                <Slider Visibility="Visible"
                                    Name="BackgroundHeightSlider"
                                    Value="{Binding Source={x:Static properties:Settings.Default}, Path=BackgroundHeight, Mode=TwoWay}"
                                Grid.Column="2"
                                Style="{StaticResource RoundedSlider}"
                                    FocusVisualStyle="{StaticResource FocusVisual}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="White" 
                                Minimum="50" 
                                Maximum="500" 
                                SmallChange="5"
                                LargeChange="10"
                                    TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                ValueChanged="BackgroundSizeExample_ValueChanged"/>
                            </Grid>
                            <Grid MaxHeight="{Binding StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Content="Edge to Edge"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"
                        ToolTip="Make the background span the entire screen width"/>
                                <CheckBox IsChecked="{Binding BackgroundEdgeToEdge, Mode=TwoWay, Source={x:Static properties:Settings.Default}}"
                                  Grid.Column="1"
                                  x:Name="BackgroundEdgeToEdgeCheckbox"
                                  Style="{StaticResource WidgetCheckBox}"
                                  BorderThickness="0"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch"
                                  Content=""
                                  FontSize="14"
                                  Click="BackgroundEdgeToEdge_Click"/>
                            </Grid>
                            
                            <Grid MaxHeight="{Binding StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        Content="Background Opacity"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"/>
                                <TextBlock Visibility="Visible"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap"
                                   Text="{Binding ElementName=BackgroundOpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Lato Light"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                                <Slider Visibility="Visible"
                                    Name="BackgroundOpacitySlider"
                                    Value="{Binding Source={x:Static properties:Settings.Default}, Path=BackgroundOpacity, Mode=TwoWay}"
                                Grid.Column="2"
                                Style="{StaticResource RoundedSlider}"
                                    FocusVisualStyle="{StaticResource FocusVisual}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="White" 
                                Minimum="0" 
                                Maximum="1" 
                                SmallChange="0.1"
                                LargeChange="0.25" 
                                IsSnapToTickEnabled="False"
                                ValueChanged="BackgroundVisuals_ValueChanged"/>
                            </Grid>

                            <Grid MaxHeight="{Binding StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        Content="Corner Radius"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"/>
                                <TextBlock Visibility="Visible"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap"
                                   Text="{Binding ElementName=BackgroundRadiusSlider, Path=Value}"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Lato Light"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                                <Slider Visibility="Visible"
                                    Name="BackgroundRadiusSlider"
                                    Value="{Binding Source={x:Static properties:Settings.Default}, Path=BackgroundCornerRadius, Mode=TwoWay}"
                                Grid.Column="2"
                                Style="{StaticResource RoundedSlider}"
                                    FocusVisualStyle="{StaticResource FocusVisual}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="White" 
                                Minimum="0" 
                                Maximum="50" 
                                SmallChange="1"
                                LargeChange="5" 
                                IsSnapToTickEnabled="True"
                                ValueChanged="BackgroundVisuals_ValueChanged"/>
                            </Grid>

                            <Grid MaxHeight="{Binding StackPanelRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>
                                <Label
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        Content="Icon Spacing"
                        Foreground="White"
                        FontFamily="Lato Light"
                        FontSize="14" 
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"/>
                                <TextBlock Visibility="Visible"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap"
                                   Text="{Binding ElementName=IconSpacingSlider, Path=Value, StringFormat={}{0:F1}}"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Lato Light"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                                <Slider Visibility="Visible"
                                    Name="IconSpacingSlider"
                                    Value="{Binding Source={x:Static properties:Settings.Default}, Path=IconSpacing, Mode=TwoWay}"
                                Grid.Column="2"
                                Style="{StaticResource RoundedSlider}"
                                    FocusVisualStyle="{StaticResource FocusVisual}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="White" 
                                Minimum="0" 
                                Maximum="20" 
                                SmallChange="0.5"
                                LargeChange="2" 
                                IsSnapToTickEnabled="False"
                                ValueChanged="IconSpacing_ValueChanged"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Height="100" Grid.Row="1" x:Name="VersionTextBox" 
                               Text="0.3.0.0 b" 
                               HorizontalAlignment="Center" 
                               TextAlignment="Center" 
                               VerticalAlignment="Bottom" 
                               FontFamily="Lato Light" 
                               FontSize="10"
                               Width="100"
                               Foreground="#33FFFFFF"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <!-- Position Tab Item Start -->
            <TabItem Visibility="Visible"
                     Background="Transparent"
                     Foreground="White"
                     FontFamily="Lato Light"
                     FontSize="14"
                     Header="Position"
                     BorderBrush="{x:Null}"
                     Style="{DynamicResource TabItemTransparent}"
                     BorderThickness="0">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" CanVerticallyScroll="True">
                    <Grid MaxHeight="{Binding StackPanelRowHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Label HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Content="Location"
                               Foreground="White"
                               FontFamily="Lato Light"
                               FontSize="14"
                               Grid.Column="0"/>
                        <ComboBox Style="{StaticResource FuzionTransparentComboBox}" 
                                  Grid.Column="1"
                              SelectionChanged="DockLocation_SelectionChanged"
                              Name="dockLocation"
                              Foreground="White"
                              Background="Transparent"
                              BorderBrush="White"
                              BorderThickness="0"
                                  Width="{StaticResource ComboBoxDesignatedWidth}"
                              FontFamily="Lato Light"
                                                             HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center"
   
                              FontSize="14">
                            <ComboBoxItem Content="Top" Style="{StaticResource FuzionComboBoxItemGreen}"/>
                            <ComboBoxItem Content="Bottom" Style="{StaticResource FuzionComboBoxItemGreen}"/>
                            <ComboBoxItem Content="Left" Style="{StaticResource FuzionComboBoxItemGreen}"/>
                            <ComboBoxItem Content="Right" Style="{StaticResource FuzionComboBoxItemGreen}"/>
                        </ComboBox>
                    </Grid>
                    <Grid MaxHeight="{Binding StackPanelRowHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Content="Monitor"
                               Foreground="White"
                               FontFamily="Lato Light"
                               FontSize="14"
                               Grid.Column="0"/>
                        <ComboBox Style="{StaticResource FuzionTransparentComboBox}"
                              SelectionChanged="ActiveMonitor_SelectionChanged"
                              x:Name="ActiveMonitor"
                              Foreground="White"
                              Background="Transparent"
                              BorderBrush="White"
                              BorderThickness="0"
