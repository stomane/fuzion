<Window x:Class="Fuzion.SettingsWindow"
        AllowsTransparency="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fuzion"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:properties="clr-namespace:Fuzion.Properties"
        xmlns:media="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
        xmlns:ccontrol="clr-namespace:Fuzion.CustomUIElements"
        mc:Ignorable="d"
        Title="Settings"
        x:Name="SettingsWindowFrontEnd"
        Height="330"
        Width="630"
        ResizeMode="CanMinimize"
        Icon="Assets\32x\settings.png"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        MouseLeftButtonUp="SettingsWindowFrontEnd_MouseLeftButtonUp"
        >
    <!--<Window.Clip>
        <RectangleGeometry Rect="0,0,620,300" RadiusX="10" RadiusY="10"/>
    </Window.Clip>-->
    <Window.Resources>
        <local:BoolToIndexConverter x:Key="BoolToIndexConverter" />
        <Storyboard x:Key="opacityDown">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                To="0.6" Duration="0:0:0.2" />
        </Storyboard>
        <!-- This storyboard will make the image revert to its original size -->
        <Storyboard x:Key="opacityUp">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                To="1" Duration="0:0:0.2" />
        </Storyboard>
        <sys:Double x:Key="StackPanelRowHeight">40</sys:Double>
        <sys:Double x:Key="StackPanelWidgetRowHeight">80</sys:Double>
        <sys:Double x:Key="ComboBoxDesignatedWidth">80</sys:Double>

    </Window.Resources>
    <Grid Width="620" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top">
        <!--<Border Name="BackgroundBorder" Margin="11">
            <Border.Background>
                <ImageBrush ImageSource="Assets/SettingsWindowTiles/window Full.png" Stretch="UniformToFill" Opacity="0.6"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Opacity="0.7" RenderingBias="Performance"/>
            </Border.Effect>
        </Border>-->
        <!-- Look into Fluent WPF Nuget package, it will probably implement rounded corners blur soon -->
        <!-- https://githubmemory.com/repo/sourcechord/FluentWPF/activity -->
        <!-- New Border -->
        <!--<Border Name="FakeBlurBorder"
                CornerRadius="{Binding ElementName=BackgroundBorder, Path=CornerRadius}"
                Opacity="0.9">
            <Border.Background>
                <ImageBrush ImageSource="Assets/fake_blur.png" Stretch="UniformToFill" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Opacity="0.7" RenderingBias="Performance"/>
            </Border.Effect>
        </Border>-->
        <Border Name="GradientBorder"
                CornerRadius="{StaticResource Window.CornerRadius}"
                BorderBrush="DimGray"
                BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform CenterY="0.5" CenterX="0.5" Angle="65"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF05323A" Offset="0"/>
                    <GradientStop Color="#FF0C443B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Opacity="{StaticResource DropShadow.Opacity}" RenderingBias="Performance"/>
            </Border.Effect>
        </Border>
        <Border Name="DragBorcer" 
                Mouse.MouseDown="Window_Drag" 
                Background="#02FFFFFF" 
                Height="32" 
                VerticalAlignment="Top" 
                Margin="0,0,44,0"
                CornerRadius="10"/>
        <!--<Border Name="BackgroundBorder"
                Opacity="0.85" 
                CornerRadius="{StaticResource Window.CornerRadius}"
                BorderThickness="1"
                BorderBrush="DimGray">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform CenterY="0.5" CenterX="0.5" Angle="65"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#B21B1B1B" Offset="0"/>
                    <GradientStop Color="#B2111111" Offset="1"/>
                    -->
        <!--<GradientStop Color="#FF0C443B" Offset="0"/>
                    <GradientStop Color="#FF05323A" Offset="1"/>-->
        <!--
                </LinearGradientBrush>
            </Border.Background>
        </Border>-->
        <!--<Border CornerRadius="0" Background="#19FFFFFF"/>-->
        <TabControl Margin="0,32,0,0"
                    Padding="10"
                    Background="Transparent" 
                    TabStripPlacement="Left" 
                    Style="{StaticResource FuzionTabControl}" 
                    SelectedIndex="0" 
                    BorderBrush="{x:Null}">
            <TabItem Background="Transparent"
                     Foreground="White"
                     FontFamily="Lato Light"
                     FontSize="14"
                     Header="General" 
                     Style="{StaticResource TabItemTransparent}" 
                     BorderThickness="0" 
                     BorderBrush="#FF323232">
                <Grid Width="Auto" Height="Auto">
                    <Grid.Resources>
                        <Storyboard x:Key="expandStoryboard">
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                To="1.2" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                To="1.2" Duration="0:0:0.2" />
                        </Storyboard>
                        <!-- This storyboard will make the image revert to its original size -->
                        <Storyboard x:Key="shrinkStoryboard">
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                To="1" Duration="0:0:0.2" />
                        </Storyboard>
                        <Storyboard x:Key="opacityDown">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                To="0.5" Duration="0:0:0.1" />
                        </Storyboard>
                        <!-- This storyboard will make the image revert to its original size -->
                        <Storyboard x:Key="opacityUp">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                To="1" Duration="0:0:0.1" />
                        </Storyboard>
                    </Grid.Resources>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" CanVerticallyScroll="True">
                        <Grid MaxHeight="{Binding StackPanelRowHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Label HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Content="Launch on Startup"
                               Foreground="White"
                               FontFamily="Lato Light"
                               FontSize="14"
                               Grid.Column="0"
                                   ToolTip="Start with Windows?"/>
                            <CheckBox Grid.Column="1"
                                      Visibility="Visible" 
                              IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=LaunchOnStartup, Mode=TwoWay}" 
                              Style="{DynamicResource WidgetCheckBox}" 
                              x:Name="StartupCheckBox" 
                              Content="" 
                              HorizontalAlignment="Stretch"  
                              VerticalAlignment="Stretch" 
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch"
                              Foreground="White" 
                              FontFamily="Lato Light" 
                              Click="StartupCheckBox_Click" 
                              FontSize="14"/>
                        </Grid>
                        <Grid MaxHeight="{Binding StackPanelRowHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Label HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Content="Show Chat Bar"
                               Foreground="White"
                               FontFamily="Lato Light"
                               FontSize="14"
                               Grid.Column="0"
                                   ToolTip="Show a shortcut to Discord and Steam Friends if available"/>
                            <CheckBox Grid.Column="1"
                                      Click="ChatBarCheckBox_Click" 
                              IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=ShowChatBar, Mode=TwoWay}"  
                              Style="{DynamicResource WidgetCheckBox}" 
                              Name="ChatBarCheckBox"
                              Content="" 
                              HorizontalAlignment="Stretch"  
                              VerticalAlignment="Stretch" 
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch"
                              Foreground="White" 
                              FontFamily="Lato Light" 
                              FontSize="14" 
                              />
                        </Grid>
                        <Grid MaxHeight="{Binding StackPanelRowHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Label HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Content="Auto Update Library"
                               Foreground="White"
                               FontFamily="Lato Light"
                               FontSize="14"
                               Grid.Column="0"
                                   ToolTip="Fuzion will automatically check for and apply game library changes every 5 minutes"/>
                            <CheckBox Grid.Column="1"
                                      Checked="AutoScanForGamesCheckBox_Toggled"
                                      Unchecked="AutoScanForGamesCheckBox_Toggled"
                                      IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=AutoScanForGames, Mode=TwoWay}"
                              Style="{DynamicResource WidgetCheckBox}" 
                              Name="AutoScanForGamesCheckBox" 
                              Content="" 
                              HorizontalAlignment="Stretch"  
                              VerticalAlignment="Stretch" 
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch"
                              Foreground="White" 
                              FontFamily="Lato Light"
                              FontSize="14" 
                              />
                        </Grid>
                        <Grid MaxHeight="{Binding StackPanelRowHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Label HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Content="Search Steam"
                               Foreground="White"
                               FontFamily="Lato Light"
                               FontSize="14"
                               Grid.Column="0"
                                   ToolTip="Should the search display Steam results too?"/>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding SearchSteam, Mode=TwoWay, Source={x:Static properties:Settings.Default}}"
                                      Checked="SearchSteam_Toggled"
                                      Unchecked="SearchSteam_Toggled"
                              Style="{DynamicResource WidgetCheckBox}" 
                              Name="SearchSteam" 
                              Content="" 
                              HorizontalAlignment="Stretch"  
                              VerticalAlignment="Stretch" 
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch"
                              Foreground="White" 
                              FontFamily="Lato Light" 
                              FontSize="14" 
                              />
                        </Grid>
                        <Grid Margin="0,4,0,4" MaxHeight="{StaticResource StackPanelRowHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Margin="0,0,4,0"
                                    Style="{DynamicResource FuzionTransparentButton}" 
                                    Background="#19FFFFFF"
                                    Foreground="White"
                                    Height="30"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                    Click="FeedbackButton_Click">
                                <Button.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                                   Grid.Column="0" 
                                                   Content="Feedback"
                                               HorizontalContentAlignment="Left"
                                               Foreground="White"
                                               FontFamily="Lato Light"
                                               FontSize="14"/>
                                        <Image Grid.Column="1"
                                               Margin="0,0,8,0"
                                               Source="Assets/64x/discord64x.png"
                                               HorizontalAlignment="Right"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Button.Content>
                            </Button>
                            <Button Grid.Column="1"
                                    Margin="4,0,4,0"
                                    Visibility="Hidden"
                                    Name="ResetLocalDatabase"
                                    Style="{DynamicResource FuzionTransparentButton}" 
                                    Background="#19FFFFFF"
                                    Foreground="White"
                                    Height="30"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                    Click="ResetLocalDatabaseButton_Click">
                                <Button.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                                   Grid.Column="0" 
                                                   Content="Reset"
                                               HorizontalContentAlignment="Left"
                                               Foreground="White"
                                               FontFamily="Lato Light"
                                               FontSize="14"/>
                                        <Image Grid.Column="1"
                                               Margin="4,4,8,4"
                                               Source="Assets/64x/resetwhite64x.png"
                                               HorizontalAlignment="Right"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Button.Content>
                            </Button>
                            <Button Grid.Column="2"
                                    Margin="4,0,0,0"
                                    Style="{DynamicResource FuzionTransparentButton}" 
                                    Background="#19FFFFFF"
                                    Foreground="White"
                                    Height="30"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                    Click="CheckForUpdatesButton_Click">
                                <Button.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                                   Grid.Column="0" 
                                                   Content="Update"
                                               HorizontalContentAlignment="Left"
                                               Foreground="White"
                                               FontFamily="Lato Light"
                                               FontSize="14"/>
                                        <Image Grid.Column="1"
                                               Margin="4,4,8,4"
                                               Source="Assets/64x/updatewhite64x.png"
                                               HorizontalAlignment="Right"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Button.Content>
                            </Button>
                        </Grid>
                        <Grid Height="120" Margin="0,5,0,-5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                            </Grid.ColumnDefinitions>
                            <Button Name="PrevDynamicImageButton" 
                                    Click="PrevDynamicImageButton_Click"
                                Grid.Column="0" Style="{StaticResource FuzionTransparentButton}" Height="15"
                                    Background="#19FFFFFF"
                                    Foreground="White"
                                    Visibility="Hidden">
                                <Button.Content>
                                    <Image Source="Assets/32x/triangle.png" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleY="0.5"/>
                                                <SkewTransform/>
                                                <RotateTransform Angle="-90"/>
                                                <TranslateTransform/>
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                </Button.Content>
                            </Button>
                            <Image Grid.Column="1"
                                   x:Name="DynamicImageContent"
                                   Mouse.MouseDown="DynamicImageContent_MouseDown">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="False">
                                                <Setter Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="White" Opacity="0.5" BlurRadius="10" RenderingBias="Performance" ShadowDepth="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Button Name="NextDynamicImageButton"  
                                    Click="NextDynamicImageButton_Click"
                                Grid.Column="2" Style="{StaticResource FuzionTransparentButton}" Height="15"
                                    Background="#19FFFFFF"
                                    Foreground="White"
                                    Visibility="Hidden">
                                <Button.Content>
                                    <Image Source="Assets/32x/triangle.png" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleY="0.5"/>
                                                <SkewTransform/>
                                                <RotateTransform Angle="90"/>
                                                <TranslateTransform/>
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                </Button.Content>
                            </Button>

                            <!--<TextBlock Text="Spare a Dogecoin for your Fuzion?"
                                   x:Name="DogeCoinLabel"
                                   Foreground="White" Margin="0,12,107,59"
