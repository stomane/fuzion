<Window x:Class="Fuzion.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fuzion"
        mc:Ignorable="d"
        Title="Console" Background="Black" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0" Width="Auto" Height="Auto" BorderThickness="0" Background="Transparent" x:Name="DebugTextBox" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Top" IsReadOnly="True" IsUndoEnabled="False" TextChanged="DebugTextBox_TextChanged" FontFamily="Consolas">
            <!--<TextBox.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource BorderBackgroundColorAnimation}"/>
                </EventTrigger>
            </TextBox.Triggers>-->
            <TextBox.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform CenterY="0.5" CenterX="0.5" Angle="65"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF18BF5C" Offset="0"/>
                    <GradientStop Color="#FF58A7D4" Offset="1"/>
                    <GradientStop Color="#FF1FDEDE" Offset="0.5"/>
                </LinearGradientBrush>
            </TextBox.Foreground>
            <TextBox.SelectionBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform CenterY="0.5" CenterX="0.5" Angle="65"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF18BF5C" Offset="0"/>
                    <GradientStop Color="#FF58A7D4" Offset="1"/>
                    <GradientStop Color="#FF1FDEDE" Offset="0.5"/>
                </LinearGradientBrush>
            </TextBox.SelectionBrush>
        </TextBox>
        <TextBox Grid.Row="1" Text="" Background="Black" Foreground="White" KeyDown="TextBox_KeyDown" FontFamily="Consolas"/>
    </Grid>
</Window>
